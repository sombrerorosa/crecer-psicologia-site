---
import Base from '../layouts/Base.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import Icon from '../components/Icon.astro';
import { getSiteSettings } from '../lib/sanity';

const settings = await getSiteSettings();
const whatsapp = settings?.whatsapp || 'https://wa.me/5491132950452';
---
<Base title="¡Gracias por escribirnos! — Crecer Psicología">
  <Header />
  <main>
    <section class="section" style="min-height:60vh;display:flex;align-items:center;justify-content:center;">
      <div class="section-inner" style="text-align:center;max-width:520px;">
        <div class="card-icon" style="margin:0 auto var(--sp-5);width:72px;height:72px;background:var(--c-green-soft);">
          <Icon name="check" class="" />
        </div>
        <h1 class="section-title" style="font-size:var(--t-h1);">¡Muchas gracias por escribirnos!</h1>
        <p class="section-lead" style="margin-top:var(--sp-3);">Te contactaremos a la brevedad para coordinar tu primera consulta.</p>
        <div style="display:flex;gap:var(--sp-3);justify-content:center;margin-top:var(--sp-6);flex-wrap:wrap;">
          <a href="/" class="btn btn-sand lg">Volver al inicio</a>
          <a href={whatsapp} target="_blank" rel="noopener noreferrer" class="btn btn-secondary lg">Escribinos por WhatsApp</a>
        </div>
      </div>
    </section>
  </main>
  <Footer />
</Base>
