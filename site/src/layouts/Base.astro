---
import '../styles/global.css';
import FloatingActions from '../components/FloatingActions.astro';
import { getSiteSettings } from '../lib/sanity';

interface Props {
  title?: string;
  description?: string;
}
const {
  title = 'Crecer Psicología — Psicología online y presencial en Canning',
  description = 'Psicología clínica para adultos y parejas. Un espacio cálido, de apoyo y respeto que favorezca el cambio para alcanzar tus objetivos.',
} = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site);
const ogImage = new URL('/assets/og-crecer-1200x630.png', Astro.site);

const settings = await getSiteSettings();
const whatsapp = settings?.whatsapp || 'https://wa.me/5491132950452';
const telephone = '+' + whatsapp.replace(/\D/g, '');
const sameAs = [settings?.instagram].filter(Boolean);

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'MedicalClinic',
  name: 'Crecer Psicología',
  url: 'https://www.crecerpsicologia.com.ar',
  logo: new URL('/assets/crecer-horizontal-positivo.png', Astro.site).toString(),
  image: ogImage.toString(),
  description: 'Psicología para adultos, jóvenes adultos y parejas. Un espacio de acompañamiento con enfoque humano y profesional.',
  slogan: 'Comprender · Acompañar · Transformar',
  areaServed: { '@type': 'Country', name: 'Argentina' },
  availableLanguage: 'es',
  telephone,
  address: {
    '@type': 'PostalAddress',
    addressLocality: 'Canning',
    addressRegion: 'Buenos Aires',
    addressCountry: 'AR',
  },
  ...(sameAs.length ? { sameAs } : {}),
};
---
<!doctype html>
<html lang="es">
<head>
  <!-- Google Tag Manager -->
  <script>(function(w,d,s,l,i){w[l]=w[l]||[];w[l].push({'gtm.start':
  new Date().getTime(),event:'gtm.js'});var f=d.getElementsByTagName(s)[0],
  j=d.createElement(s),dl=l!='dataLayer'?'&l='+l:'';j.async=true;j.src=
  'https://www.googletagmanager.com/gtm.js?id='+i+dl;f.parentNode.insertBefore(j,f);
  })(window,document,'script','dataLayer','GTM-KNQ37RW');</script>
  <!-- End Google Tag Manager -->
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{title}</title>
  <meta name="description" content={description} />
  <link rel="canonical" href={canonical} />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:type" content="website" />
  <meta property="og:image" content={ogImage} />
  <link rel="icon" href="/assets/favicon.ico" sizes="any" />
  <link rel="icon" type="image/png" sizes="16x16" href="/assets/favicon-16x16.png" />
  <link rel="icon" type="image/png" sizes="32x32" href="/assets/favicon-32x32.png" />
  <link rel="apple-touch-icon" href="/assets/apple-touch-icon.png" />
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,400;0,500;0,600;0,700;1,400;1,500;1,600&family=DM+Sans:ital,wght@0,400;0,500;0,700;1,400&display=swap" rel="stylesheet">
  <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
</head>
<body>
  <!-- Google Tag Manager (noscript) -->
  <noscript><iframe src="https://www.googletagmanager.com/ns.html?id=GTM-KNQ37RW"
  height="0" width="0" style="display:none;visibility:hidden"></iframe></noscript>
  <!-- End Google Tag Manager (noscript) -->
  <slot />
  <FloatingActions />
  <script>
    const animObserver = new IntersectionObserver((entries) => {
      entries.forEach(({ target, isIntersecting }) => {
        if (isIntersecting) {
          target.classList.add('is-visible');
          animObserver.unobserve(target);
        }
      });
    }, { threshold: 0.12 });
    document.querySelectorAll('[data-animate]').forEach((el) => animObserver.observe(el));
  </script>
</body>
</html>
