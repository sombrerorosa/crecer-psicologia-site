---
interface Props {
  title: string;
  lead: string;
  hubspotFormId: string;
  showCountryField?: boolean;
  phonePlaceholder?: string;
}
const {
  title,
  lead,
  hubspotFormId,
  showCountryField = false,
  phonePlaceholder = '+54 9 11 1234 5678',
} = Astro.props;
const formId = `contact-form-${hubspotFormId.slice(0, 8)}`;
---
<section class="section contact-band" id="contacto">
  <div class="section-inner">
    <div class="section-head">
      <h2 class="section-title">{title}</h2>
      <p class="section-lead">{lead}</p>
    </div>
    <form class="contact-form-grid" id={formId} data-contact-form novalidate>
      <div class="contact-form-row">
        <div class="field">
          <label>Nombre <span class="req">*</span></label>
          <input class="input" name="name" type="text" placeholder="Ej: María" required />
        </div>
        <div class="field">
          <label>Apellido</label>
          <input class="input" name="apellidos" type="text" placeholder="Ej: Fernández" />
        </div>
      </div>
      <div class="contact-form-row">
        <div class="field">
          <label>Email <span class="req">*</span></label>
          <input class="input" name="email" type="email" placeholder="vos@email.com" required />
        </div>
        {showCountryField ? (
          <div class="field">
            <label>País / región <span class="req">*</span></label>
            <input class="input" name="country" type="text" placeholder="Ej: España" required />
          </div>
        ) : (
          <div class="field">
            <label>Teléfono</label>
            <input class="input" name="phone" type="tel" placeholder={phonePlaceholder} />
          </div>
        )}
      </div>
      {showCountryField && (
        <div class="field">
          <label>Teléfono</label>
          <input class="input" name="phone" type="tel" placeholder={phonePlaceholder} />
        </div>
      )}
      <div class="field">
        <label>Mensaje</label>
        <textarea class="textarea" name="msg" placeholder="¿Cuál es el motivo de tu consulta?"></textarea>
      </div>
      <button class="btn btn-sand lg" type="submit" style="width:100%;">Enviar</button>
    </form>
  </div>
</section>

<script>
  document.querySelectorAll('form[data-contact-form]').forEach((form) => {
    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      const el = form as HTMLFormElement;
      const btn = el.querySelector('button[type="submit"]') as HTMLButtonElement;

      const get = (name: string) => (el.elements.namedItem(name) as HTMLInputElement | null)?.value ?? '';
      const payload = {
        firstname: get('name'),
        lastname: get('apellidos'),
        email: get('email'),
        phone: get('phone'),
        country: get('country'),
        message: get('msg'),
        pageUri: window.location.href,
        pageName: document.title,
      };

      btn.classList.add('is-loading');
      btn.disabled = true;

      try {
        const res = await fetch('/api/submit', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify(payload),
        });
        if (!res.ok) {
          const body = await res.text();
          console.error('[submit] failed', res.status, body);
          throw new Error(body || `HTTP ${res.status}`);
        }
        // Redirect en vez de reemplazar el form in-place: así se dispara
        // la conversión de medios (Meta/Google Ads) atada a /gracias.
        window.location.href = '/gracias';
      } catch (err) {
        btn.classList.remove('is-loading');
        btn.disabled = false;
        alert('Hubo un error al enviar. Por favor intentá de nuevo o escribinos por WhatsApp.');
      }
    });
  });
</script>
