---
import { ICONS } from '../lib/icons';
interface Props { name: keyof typeof ICONS; class?: string }
const { name, class: cls } = Astro.props;
const path = ICONS[name] ?? '';
---
<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" class={cls} set:html={path}></svg>
