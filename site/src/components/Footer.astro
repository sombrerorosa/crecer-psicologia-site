---
import { getSiteSettings } from '../lib/sanity';

const settings = await getSiteSettings();
const instagram = settings?.instagram;

const NAV = [
  { href: '/', label: 'Inicio' },
  { href: '#especialidades', label: 'Especialidades' },
  { href: '#enfoque', label: 'Nuestro Enfoque' },
  { href: '#contacto', label: 'Contacto' },
];
---
<footer class="site-footer">
  <div class="ft-inner">
    <div class="nm">Crecer Psicología</div>
    <nav class="ft-nav" aria-label="Footer">
      {NAV.map((item) => <a href={item.href}>{item.label}</a>)}
      {instagram && (
        <a href={instagram} target="_blank" rel="noopener noreferrer" aria-label="Instagram" class="ft-social">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" width="18" height="18">
            <rect width="20" height="20" x="2" y="2" rx="5" ry="5"></rect>
            <path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z"></path>
            <line x1="17.5" x2="17.51" y1="6.5" y2="6.5"></line>
          </svg>
        </a>
      )}
    </nav>
  </div>
  <div class="ft-bottom">© {new Date().getFullYear()} Crecer Psicología. Todos los derechos reservados.</div>
</footer>

<style>
  .ft-social { display: inline-flex; align-items: center; }
</style>
